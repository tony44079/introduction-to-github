<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kamawe - Your Online Marketplace</title>
    <style>
        body {
            font-family: sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        header {
            background-color: #3498db;
            color: white;
            text-align: center;
            padding: 20px 0;
        }

        .container {
            width: 80%;
            margin: 20px auto;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .product-item {
            border: 1px solid #ddd;
            padding: 15px;
            text-align: center;
        }

        .product-item img {
            max-width: 100%;
            height: auto;
            margin-bottom: 10px;
        }

        .product-item button {
            background-color: #27ae60;
            color: white;
            padding: 10px 15px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 10px 0;
            position:relative;
            bottom:0;
            width:100%;
        }

    </style>
</head>
<body>

    <header>
        <h1>Welcome to Kamawe</h1>
        <p>Discover amazing products at unbeatable prices!</p>
    </header>

    <div class="container">
        <h2>Featured Products</h2>
        <div class="product-grid">
            <div class="product-item">
                <img src="placeholder-product.jpg" alt="Product 1">
                <h3>Product 1 Name</h3>
                <p>$19.99</p>
                <button>Add to Cart</button>
            </div>
            <div class="product-item">
                <img src="placeholder-product.jpg" alt="Product 2">
                <h3>Product 2 Name</h3>
                <p>$29.99</p>
                <button>Add to Cart</button>
            </div>
            <div class="product-item">
                <img src="placeholder-product.jpg" alt="Product 3">
                <h3>Product 3 Name</h3>
                <p>$39.99</p>
                <button>Add to Cart</button>
            </div>
            <div class="product-item">
                <img src="placeholder-product.jpg" alt="Product 4">
                <h3>Product 4 Name</h3>
                <p>$49.99</p>
                <button>Add to Cart</button>
            </div>
            <div class="product-item">
                <img src="placeholder-product.jpg" alt="Product 5">
                <h3>Product 5 Name</h3>
                <p>$59.99</p>
                <button>Add to Cart</button>
            </div>
            <div class="product-item">
                <img src="placeholder-product.jpg" alt="Product 6">
                <h3>Product 6 Name</h3>
                <p>$69.99</p>
                <button>Add to Cart</button>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 Kamawe. All rights reserved.</p>
    </footer>

    <script>
        // You can add JavaScript functionality here, like handling "Add to Cart" clicks.
        // For example:
        document.querySelectorAll('.product-item button').forEach(button => {
            button.addEventListener('click', () => {
                alert('Product added to cart!'); // Replace with actual cart logic
            });
        });
    </script>
</body>
</html>
